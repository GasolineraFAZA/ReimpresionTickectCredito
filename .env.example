# ══════════════════════════════════════════════════════
# ARCHIVO: .env.example  —  Plantilla de configuración
# Copia este archivo como .env y llena los valores reales
# ══════════════════════════════════════════════════════

# ── API FAZA ──────────────────────────────────────────
API_BASE_URL=http://SERVIDOR:PUERTO
API_KEY_HEADER_NAME=ApiKey
API_KEY_HEADER_VALUE=

# ── Base de datos ERPFaza ─────────────────────────────
ERPFAZA_SERVER=
ERPFAZA_DATABASE=ERPFaza
ERPFAZA_USER=
ERPFAZA_PASSWORD=

# ── Claves de encriptación ────────────────────────────
CRYPTO_SALT=
CRYPTO_IV=
CRYPTO_PASSWORD=

# ── Credenciales de autorización de reimpresión ───────
AUTH_USUARIO=
AUTH_PASSWORD=
